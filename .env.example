# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_rag
REDIS_URL=redis://localhost:6379

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-key

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=contract-rag-dev

GEMINI_API_KEY=changeme

JWT_SECRET=replace-with-a-random-32-plus-character-secret

# Optional — omit to disable Sentry in local development
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0


# Optional — OpenTelemetry falls back to console-only span export (fine for local dev) when
# unset. Point it at a real collector (Jaeger, Tempo, an OTel Collector) to see traces
# anywhere other than stdout.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318